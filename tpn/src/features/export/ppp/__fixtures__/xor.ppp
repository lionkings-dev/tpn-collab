module g1(o3+,o3-;o1+,o1-){
place (p0,p1,p2,p3,p4,p5,p6);
trans (o3+,o3-,t2@g1,t3@g1,o1+,o1-);
token (p1,p3,p5,p6);

o3+ (p0)/(p1);
o3- (p1)/(p0);
t2@g1 [0,0] (p1,p6,p2)/(p1,p3);
t3@g1 [0,0] (p1,p6,p3)/(p1,p2);
o1+ [4,5] (p3,p4)/(p3,p5,p6);
o1- [4,5] (p2,p5)/(p2,p4,p6);
o3+ = (o3+);
o3- = (o3-);
o1+ = (o1+);
o1- = (o1-);
}

module g2(o1+,o1-;o2+,o2-){
place (p0,p1,p2,p3,p4,p5,p6);
trans (o1+,o1-,t2@g2,t3@g2,o2+,o2-);
token (p1,p3,p5,p6);

o1+ (p0)/(p1);
o1- (p1)/(p0);
t2@g2 [0,0] (p1,p6,p2)/(p1,p3);
t3@g2 [0,0] (p1,p6,p3)/(p1,p2);
o2+ [4,5] (p3,p4)/(p3,p5,p6);
o2- [4,5] (p2,p5)/(p2,p4,p6);
o1+ = (o1+);
o1- = (o1-);
o2+ = (o2+);
o2- = (o2-);
}

module g3(o2+,o2-;o3+,o3-){
place (p0,p1,p2,p3,p4,p5,p6);
trans (o2+,o2-,t2@g3,t3@g3,o3+,o3-);
token (p1,p3,p5,p6);

o2+ (p0)/(p1);
o2- (p1)/(p0);
t2@g3 [0,0] (p1,p6,p2)/(p1,p3);
t3@g3 [0,0] (p1,p6,p3)/(p1,p2);
o3+ [4,5] (p3,p4)/(p3,p5,p6);
o3- [4,5] (p2,p5)/(p2,p4,p6);
o2+ = (o2+);
o2- = (o2-);
o3+ = (o3+);
o3- = (o3-);
}

spec(;o1-,o1+,o2-,o2+,o3-,o3+){
place (p0,p1,p2,p3,p4,p5);
trans(o1+,o1-,o2+,o2-,o3+,o3-);
token (p0,p2,p4);
o1- (p0)/(p1);
o1+ (p1)/(p0);
o2- (p2)/(p3);
o2+ (p3)/(p2);
o3- (p4)/(p5);
o3+ (p5)/(p4);
o1-=(o1-);
o1+=(o1+);
o2-=(o2-);
o2+=(o2+);
o3-=(o3-);
o3+=(o3+);
}
