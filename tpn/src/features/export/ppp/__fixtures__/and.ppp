// g7@er AND GATE
module g7@er(w4@er-, w4@er+, w5@er-, w5@er+; w7@er+, w7@er-){
  place (p0, p1, p2, p3, p4, p5, p6, p7);
  trans (w7@er+, w7@er-, t2@g7@er, t3@g7@er, t4@g7@er, w4@er-, w4@er+, w5@er-, w5@er+);
  token (p1, p3, p4, p7);
  w7@er+ [4,5] (p0, p7)/(p0, p6);
  w7@er- [4,5] (p1, p6)/(p1, p7);
  t2@g7@er [0,0] (p1, p2, p4)/(p0, p2, p4);
  t3@g7@er [0,0] (p0, p3)/(p1, p3);
  t4@g7@er [0,0] (p0, p5)/(p1, p5);
  w4@er- (p4)/(p5);
  w4@er+ (p5)/(p4);
  w5@er- (p2)/(p3);
  w5@er+ (p3)/(p2);
  w7@er+ = (w7@er+);
  w7@er- = (w7@er-);
  w4@er- = (w4@er-);
  w4@er+ = (w4@er+);
  w5@er- = (w5@er-);
  w5@er+ = (w5@er+);

}
